# Email provider: "resend" (Vercel copy) or "ses" (AWS copy)
EMAIL_PROVIDER=resend

# Resend (existing — used when EMAIL_PROVIDER=resend)
RESEND_API_KEY=
LEAD_TO_EMAIL=
LEAD_FROM_EMAIL=

# Amazon SES (used when EMAIL_PROVIDER=ses)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=

# Database (local default; on the box use /var/lib/jj-crm/crm.db)
SQLITE_DB_PATH=./data/crm.db

# Auth
SESSION_SECRET=            # 32+ random bytes; signs the admin session cookie
BCRYPT_COST=12

# Site — canonical origin. Required in production: the build fails without it,
# by design, so the site can never publish canonicals for a domain we don't own.
NEXT_PUBLIC_SITE_URL=http://localhost:3004

# --- Email marketing (SES v2) ---
# Marketing mail is deliberately separate from the transactional path above:
# a different verified identity, its own SES configuration set, and its own
# reputation stream, so a bad campaign cannot damage inquiry-ack deliverability.
MARKETING_FROM_EMAIL=            # SES-verified identity, e.g. news@mail-jj.twenty1-media.com
MARKETING_REPLY_TO=              # a monitored human inbox
SES_CONFIGURATION_SET=jj-marketing

# CAN-SPAM requires a physical postal address in every commercial email.
# The send path refuses to build a marketing footer without it.
MARKETING_BUSINESS_ADDRESS=

# Signs one-click unsubscribe tokens. 32+ random bytes.
# Rotating this invalidates every unsubscribe link in every already-delivered
# email, so treat it as permanent once the first campaign ships.
UNSUB_SECRET=

# Shared secrets for the two public machine endpoints.
MARKETING_CRON_KEY=              # x-cron-key header on POST /api/marketing/tick
MARKETING_SNS_SLUG=              # secret path segment of /api/marketing/webhooks/<slug>
