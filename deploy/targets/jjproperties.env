# Deploy target: J&J Resort Properties brand site (tenant #3)
#
# Sourced by deploy/deploy.sh. Shell syntax, but treat it as data: it is read
# with `set -u` in force and every value below is non-secret and committed.
# NOTHING SECRET GOES IN THIS FILE. Credentials live in ~/app-jjproperties/.env.local
# on the box; the deploy never reads or writes them.
#
# This site moved off Vercel on 2026-08-14. It is the only tenant with no CMS —
# no Payload, no database, no S3 bucket. The one server-side surface is
# /api/contact, which posts a lead to Resend.

# --- identity -----------------------------------------------------------------
TARGET_NAME=jjproperties

# Guard against deploying the wrong repo to this target. Compared against the
# "name" field of the local package.json before anything is transferred.
# NOTE: the package is still called "jj-properties-temp" — a leftover from when
# this repo was a scratch build. Renaming it is a one-line change here and in
# package.json; it has not been done because nothing else depends on the name
# and a rename mid-migration would fail this very guard.
EXPECT_PACKAGE_NAME=jj-properties-temp

# --- connection ---------------------------------------------------------------
SSH_HOST=ubuntu@3.133.239.181
SSH_KEY=~/.ssh/lightsail-us-east-2.pem
# Deliberately NOT /home/ubuntu/app — that is Cedarville's. Each tenant gets its
# own app dir; the deploy mirrors SYNC_DIRS with --delete and pointing two
# tenants at one directory would have each deploy erase the other.
REMOTE_DIR=/home/ubuntu/app-jjproperties

# --- service ------------------------------------------------------------------
SERVICE=jjproperties
PORT=3002
# Temporary origin until the client buys jjresortproperties.com. nip.io resolves
# any <label>.<dashed-ip>.nip.io to that IP, so this needs no DNS of its own and
# certbot will issue for it. Swap this line and add the domain vhost when the
# real domain lands — see deploy/nginx/jjproperties-domain.conf.
PUBLIC_ORIGIN=https://jj.3-133-239-181.nip.io

# Other tenants on the SAME box. A brand-site deploy must not disturb them, so
# each is checked before the deploy (baseline) and again after (must be
# unchanged: still running, no new automatic restarts, still serving 200).
# cedarville is LIVE and serving real guests — it is the reason this file caps
# build memory as tightly as it does.
SIBLING_SERVICES="cedarville:3000 tahquamenon:3001"

# --- what gets shipped --------------------------------------------------------
SYNC_DIRS="src public"
SYNC_FILES="package.json package-lock.json next.config.ts postcss.config.mjs tsconfig.json eslint.config.mjs"

# --- build --------------------------------------------------------------------
# Webpack, matching Cedarville. The box is linux/x64 and could use Turbopack;
# changing bundlers as a side effect of a hosting migration is not a change
# anyone asked for.
BUILD_ARGS="--webpack"

# Tighter than Cedarville's 1200M on purpose. This box has ~1.9GB RAM and is now
# running three Next servers. If a build does blow up, the kernel must kill the
# BUILD — not cedarville.service, which is the largest process on the box and is
# serving hotel guests.
BUILD_MEMORY_MAX=900M
BUILD_MEMORY_SWAP_MAX=2G
NODE_MAX_OLD_SPACE=768

# Refuse to start a build unless this much memory is available (MemAvailable,
# MB) and this much free disk (MB). Raised above Cedarville's 600MB because a
# third resident server has already eaten into the headroom.
MIN_AVAILABLE_MB=700
MIN_FREE_DISK_MB=3000

# --- health -------------------------------------------------------------------
# Every one of these must return 200 AND contain exactly one <html> and one
# <body>. These are all seven pages the site has.
HEALTH_ROUTES="/ /about /properties /invest /sell /contact /thank-you"
HEALTH_MIN_HTML_BYTES=2000

# Tags every public page must contain at least one of.
HEALTH_HTML_REQUIRE="main h1 footer"

# No CMS on this tenant, so no admin panel to check. Leaving these empty is what
# tells healthcheck.sh to skip that section rather than fail it.
HEALTH_ADMIN_PATH=
HEALTH_ADMIN_MARKER=

# Modules that must load from the app dir after install. Cedarville also lists
# `payload`; this site has none.
REQUIRE_MODULES="sharp next"

# Non-HTML routes: fetched, must be 200, each with its own content assertion in
# healthcheck.sh.
HEALTH_ASSETS="/robots.txt /sitemap.xml /favicon.ico"

# Page whose optimized images are sampled — proves /_next/image returns image
# bytes and not an error page. The home hero is the heaviest image route here.
HEALTH_IMAGE_PAGE=/
HEALTH_IMAGE_SAMPLES=5

# --- retention ----------------------------------------------------------------
KEEP_RELEASES=3
